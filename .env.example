# Скопируйте этот файл в .env и заполните значения
NODE_ENV=production
PORT=3000
ALLOWED_ORIGIN=https://practicai.ru

DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# CRM включается после установки уникального пароля длиной не менее 16 символов
ADMIN_USER=admin
ADMIN_PASSWORD=
SITE_ORIGIN=https://practicai.ru
